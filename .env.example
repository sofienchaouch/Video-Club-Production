# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Plaintext password used to gain write-access to the content editor.
# Defaults to "admin123" if not defined in the backend environment.
ADMIN_PASSWORD="admin123"

# ADMIN_SECRET: Secret key used to sign secure session tokens.
ADMIN_SECRET="your-super-secret-jwt-key-here"

# UPSTASH_*: Redis REST credentials, from the Upstash console database page.
# This is the preferred store. When both are set they take priority over the
# FIREBASE_* vars below, and no service account key is needed.
UPSTASH_REDIS_REST_URL="https://my-database-12345.upstash.io"
UPSTASH_REDIS_REST_TOKEN="my-upstash-rest-token"

# FIREBASE_*: Service account credentials for Firestore.
# Optional alternative to UPSTASH_* above — set one pair or the other, not both.
# Required in production — Vercel's filesystem is ephemeral, so without these
# every admin change is lost on the next cold start or redeploy.
# Taken from the JSON key generated in Firebase Console > Project settings >
# Service accounts > Generate new private key.
# Keep FIREBASE_PRIVATE_KEY on one line with literal \n escapes for the newlines.
FIREBASE_PROJECT_ID="my-firebase-project-id"
# FIREBASE_DATABASE_ID: Optional. Defaults to "(default)".
# AI Studio projects provision a generated database id instead, shown in the
# dropdown at the top of the Firestore Data tab. Set it if yours is not "(default)".
FIREBASE_DATABASE_ID="(default)"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@my-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMY_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

