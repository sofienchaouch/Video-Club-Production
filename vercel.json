{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "dynamic_*.json",
        "public/uploads/**",
        "uploads/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
